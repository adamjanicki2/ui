{
  "name": "@adamjanicki/ui",
  "version": "1.9.2",
  "description": "Basic UI components and hooks for React in TypeScript",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "author": "Adam Janicki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjanicki2/ui.git"
  },
  "scripts": {
    "clean": "python3 clean.py",
    "lint": "eslint src test --fix && prettier --write \"src/**/*.{ts,tsx,json,css,scss,md}\" \"test/**/*.{ts,tsx}\"",
    "test": "jest --silent",
    "build": "npm test && eslint src test --max-warnings=0 && python3 build.py",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.27.2",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "sass": "^1.90.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
