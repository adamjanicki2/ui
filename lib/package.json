{
  "name": "@adamjanicki/ui",
  "version": "1.6.2",
  "description": "Basic UI components and hooks for React in TypeScript",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "author": "Adam Janicki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjanicki2/ui.git"
  },
  "scripts": {
    "clean": "python clean.py",
    "lint": "eslint src test --max-warnings=0",
    "test": "jest",
    "scss": "sass --no-source-map --style=compressed src/style.scss style.css",
    "build": "npm run clean && npm run lint && npm test && tsc && npm run scss",
    "prepare": "npm run build",
    "dryrun": "npm publish --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "sass": "^1.90.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
